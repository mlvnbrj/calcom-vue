{
  "name": "calcom-vue",
  "version": "2.0.1",
  "description": "Vue 3 & Nuxt plugin for seamless Cal.com modal and embed integration",
  "author": "Melvin Borja <melvinmoratoborja@gmail.com>",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "cal.com",
    "calendar",
    "booking",
    "scheduler"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mlvnbrj/calcom-vue.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "playground": "npm run playground:vue",
    "playground:vue": "vite",
    "playground:nuxt": "nuxt dev playground/nuxt",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "nuxt": "^4.6.4",
    "tsup": "^9.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.7",
    "vue": "^3.5.45"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
