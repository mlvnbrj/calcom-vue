{
  "name": "calcom-vue",
  "version": "1.0.1",
  "description": "Vue 3 & Nuxt plugin for seamless Cal.com modal and embed integration",
  "author": "Melvin Borja <melvinmoratoborja@gmail.com>",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "cal.com",
    "calendar",
    "booking",
    "scheduler"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0", 
    "tsup": "^9.0.0",
    "typescript": "^5.0.0", 
    "vue": "^3.5.45"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
